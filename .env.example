# AgriTrace Configuration Environment Variables
# Stack: FastAPI, SQLite, Optional FalkorDB, Supabase, Google Gemini

# Server & Security
# Generate a secure key via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_your_own_secure_random_key_min_32_chars

# Allowed CORS Origins (comma-separated, default: http://localhost:8000,http://127.0.0.1:8000)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# FalkorDB Graph Database Configuration (Optional: embedded SQLite graph is used if FalkorDB is not connected)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=agritrace_graph

# Supabase Configuration (Optional: data stays safely local on this server if unset)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key from Google AI Studio (Optional: deterministic rule-based mode is used if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=auto
